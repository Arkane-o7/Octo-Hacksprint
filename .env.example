# Copy to .env. Put secrets in that local file, never in chat or Git.
OCTO_MODE=offline
# Required in live mode: 32 random bytes encoded as 64 hex characters.
# Generate locally; back up separately. Never commit the real value.
OCTO_DB_KEY=
# Experimental broad text/event parser; NOT reliable enough for live claims yet.
# Keep false for the established requirement/syllabus/class-day flow.
OCTO_GENERAL_BRAIN=false
# Optional free WAHA NOWEB list picker in private chats; verify on the handset.
OCTO_TAPPABLE_MENUS=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DOCUMENT_LANGUAGE=en-IN
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_PASSWORD=
# Keep offline roster as-is; copy/edit roster.local.json for live IDs.
OCTO_ROSTER=roster.example.json
OCTO_DATA_DIR=data
OCTO_REMINDER_TIME=18:00
# Optional: dedicated demo Drive folder and local OAuth JSON with
# client_id, client_secret and refresh_token. Keep that file out of Git.
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=
# Same authorized-user file works for Calendar; helper creates a dedicated
# secondary calendar with calendar.app.created scope, never the primary one.
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

